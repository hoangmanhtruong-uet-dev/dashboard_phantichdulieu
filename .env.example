# Runtime environment: development | staging | production | test
APP_ENV=development

# Server-only. Production must set an explicit persistent database path.
DATABASE_PATH=./sales.db

# Comma-separated origins. Production must not rely on wildcard CORS.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Development/test convenience only. Set false in staging/production.
SEED_DEMO_DATA=true

# HTTP listener used by local uvicorn and supported hosting platforms.
PORT=8000

# Server-only authentication configuration. Generate a unique 32+ character
# secret for production. Never expose this value to frontend JavaScript.
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SESSION_DAYS=30
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_ROWS=100000
MAX_IMPORT_COLUMNS=100
PREVIEW_ROWS=20
MAX_CELL_CHARS=10000
MAX_WORKBOOK_UNCOMPRESSED_BYTES=104857600

# PUBLIC/CLIENT CONFIGURATION
# The current frontend uses same-origin API requests. If split hosting is added,
# expose only a public API base URL through window.NEXUS_CONFIG.apiBaseUrl.
# Never place server credentials or provider keys in client configuration.
