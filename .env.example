# development | test | staging | production
APP_ENV=development
PORT=8000

# Local/test may use SQLite. Staging/production require DATABASE_URL PostgreSQL.
DATABASE_PATH=./sales.db
DATABASE_URL=
SEED_DEMO_DATA=true

# Exact comma-separated frontend origins; wildcard is rejected outside local/test.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SESSION_DAYS=30

# Central Redis/Valkey is mandatory outside local/test.
REDIS_URL=
QUEUE_NAME=nexus-jobs

# Local storage is local/test only. Staging/production require private S3.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OBJECT_RETENTION_DAYS=30

# Backup cron object namespace; use an environment-specific prefix outside local use.
BACKUP_S3_BUCKET=
BACKUP_PREFIX=local/postgres

# Required in staging/production; never expose this DSN in config.js.
SENTRY_DSN=

MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_ROWS=100000
MAX_IMPORT_COLUMNS=100
PREVIEW_ROWS=20
MAX_CELL_CHARS=10000
MAX_WORKBOOK_UNCOMPRESSED_BYTES=104857600

# Public build-time frontend value only.
PUBLIC_API_BASE_URL=http://localhost:8000
